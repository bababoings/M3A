    "components": {
        "schemas": {
            "CreateEventDto": {
                "required": [
                    "name",
                    "dateTime",
                    "eventCapacity",
                    "venueId"
                ],
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Human readable title of the event."
                    },
                    "dateTime": {
                        "type": "string",
                        "description": "When the event takes place.",
                        "format": "date-time"
                    },
                    "eventCapacity": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "integer",
                            "string"
                        ],
                        "description": "Total capacity allocated for this event.",
                        "format": "int32"
                    },
                    "venueId": {
                        "type": "string",
                        "description": "Identifier of the venue hosting this event."
                    }
                },
                "description": "Payload for `POST /events`."
            },
            "CreateItemDto": {
                "required": [
                    "name"
                ],
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Human readable name."
                    }
                },
                "description": "Payload for `POST /items`."
            },
            "CreateTicketDto": {
                "required": [
                    "eventId"
                ],
                "type": "object",
                "properties": {
                    "eventId": {
                        "type": "string"
                    }
                },
                "description": "Request body to create a ticket."
            },
            "CreateVenueDto": {
                "required": [
                    "location",
                    "capacity"
                ],
                "type": "object",
                "properties": {
                    "location": {
                        "type": "string",
                        "description": "Where the venue is."
                    },
                    "capacity": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
